// tremor-invictus: the weapon column's icons as 2D shaders that take the
// HUD's colour and fade (hud.md 9.7; the icons' own shaders ignore it)

tremor/hudw_bfg
{
	nopicmip
	{
		map icons/iconw_bfg.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

