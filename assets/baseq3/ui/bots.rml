<rml>
<head>
	<title>Bots</title>
	<link type="text/rcss" href="tremor.rcss"/>
</head>
<body data-escape="rml_show ui/ingame.rml">
	<div class="settings">
		<h1>[bt_title]</h1>
		<div class="tabs">
			<button class="tab" data-class="on:ui_botTab=0" onclick="set ui_botTab 0">[menu_add_bots]</button>
			<button class="tab" data-class="on:ui_botTab=1" onclick="ui_botRefresh; set ui_botTab 1">[menu_remove_bots]</button>
			<button class="tab" data-when="ui_botTeamGame=1" data-class="on:ui_botTab=2" onclick="ui_botRefresh; set ui_botTab 2">[menu_team_orders]</button>
		</div>
		<div class="spage" data-when="ui_botTab=0">
			<div class="srow" data-when="ui_ingameGametype=1"><span class="slabel">[bt_duel_warn]</span></div>
			<div class="srow"><span class="slabel">[cs_skill]</span><span class="svalue"><button class="opt" data-class="on:ui_botSkill=1" onclick="set ui_botSkill 1">1</button><button class="opt" data-class="on:ui_botSkill=2" onclick="set ui_botSkill 2">2</button><button class="opt" data-class="on:ui_botSkill=3" onclick="set ui_botSkill 3">3</button><button class="opt" data-class="on:ui_botSkill=4" onclick="set ui_botSkill 4">4</button><button class="opt" data-class="on:ui_botSkill=5" onclick="set ui_botSkill 5">5</button></span></div>
			<div class="srow" data-when="ui_botTeamGame=1"><span class="slabel">[bt_team]</span><span class="svalue">
				<button class="opt" data-class="on:ui_botTeam=" onclick="set ui_botTeam &quot;&quot;">[join_auto]</button>
				<button class="opt" data-class="on:ui_botTeam=red" onclick="set ui_botTeam red">[join_red]</button>
				<button class="opt" data-class="on:ui_botTeam=blue" onclick="set ui_botTeam blue">[join_blue]</button></span></div>
			<div class="srow"><span class="slabel">[bt_add]</span><span class="svalue"><button class="opt champ" onclick="ui_botAdd ranger">[champ_ranger]</button><button class="opt champ" onclick="ui_botAdd anarki">[champ_anarki]</button><button class="opt champ" onclick="ui_botAdd athena">[champ_athena]</button><button class="opt champ" onclick="ui_botAdd nyx">[champ_nyx]</button><button class="opt champ" onclick="ui_botAdd slash">[champ_slash]</button><button class="opt champ" onclick="ui_botAdd bj">[champ_bj]</button><button class="opt champ" onclick="ui_botAdd deathknight">[champ_deathknight]</button><button class="opt champ" onclick="ui_botAdd doomslayer">[champ_doomslayer]</button><button class="opt champ" onclick="ui_botAdd eisen">[champ_eisen]</button><button class="opt champ" onclick="ui_botAdd galena">[champ_galena]</button><button class="opt champ" onclick="ui_botAdd strogg">[champ_strogg]</button><button class="opt champ" onclick="ui_botAdd visor">[champ_visor]</button><button class="opt champ" onclick="ui_botAdd clutch">[champ_clutch]</button><button class="opt champ" onclick="ui_botAdd keel">[champ_keel]</button><button class="opt champ" onclick="ui_botAdd scalebearer">[champ_scalebearer]</button><button class="opt champ" onclick="ui_botAdd sorlag">[champ_sorlag]</button><button class="opt champ" onclick="ui_botAdd wrack">[champ_wrack]</button><button class="opt champ" onclick="ui_botAdd sarge">[champ_sarge]</button><button class="opt champ" onclick="ui_botAdd klesk">[champ_klesk]</button><button class="opt champ" onclick="ui_botAdd hunter">[champ_hunter]</button><button class="opt champ" onclick="ui_botAdd xaero">[champ_xaero]</button><button class="opt champ" onclick="ui_botAdd raine">[champ_raine]</button><button class="opt champ" onclick="ui_botAdd beastmaster">[champ_beastmaster]</button><button class="opt champ" onclick="ui_botAdd unumrey">[champ_unumrey]</button></span></div>
		</div>
		<div class="spage" data-when="ui_botTab=1">
			<div class="srow" data-when="ui_bot0_name!="><span class="slabel" data-text-cvar="ui_bot0_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 0">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot1_name!="><span class="slabel" data-text-cvar="ui_bot1_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 1">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot2_name!="><span class="slabel" data-text-cvar="ui_bot2_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 2">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot3_name!="><span class="slabel" data-text-cvar="ui_bot3_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 3">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot4_name!="><span class="slabel" data-text-cvar="ui_bot4_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 4">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot5_name!="><span class="slabel" data-text-cvar="ui_bot5_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 5">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot6_name!="><span class="slabel" data-text-cvar="ui_bot6_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 6">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot7_name!="><span class="slabel" data-text-cvar="ui_bot7_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 7">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot8_name!="><span class="slabel" data-text-cvar="ui_bot8_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 8">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot9_name!="><span class="slabel" data-text-cvar="ui_bot9_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 9">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot10_name!="><span class="slabel" data-text-cvar="ui_bot10_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 10">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot11_name!="><span class="slabel" data-text-cvar="ui_bot11_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 11">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot12_name!="><span class="slabel" data-text-cvar="ui_bot12_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 12">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot13_name!="><span class="slabel" data-text-cvar="ui_bot13_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 13">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot14_name!="><span class="slabel" data-text-cvar="ui_bot14_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 14">[bt_remove]</button></span></div>
			<div class="srow" data-when="ui_bot15_name!="><span class="slabel" data-text-cvar="ui_bot15_name"></span><span class="svalue"><button class="opt" onclick="ui_botRemove 15">[bt_remove]</button></span></div>
		</div>
		<div class="spage" data-when="ui_botTab=2">
			<div class="srow"><span class="slabel">[bt_command]</span><span class="svalue"><button class="opt" onclick="ui_botLeader 1">[bt_leader]</button><button class="opt" onclick="ui_botLeader 0">[bt_notleader]</button></span></div>
			<div class="srow" data-when="ui_bot0_name!=&amp;ui_bot0_mate=1"><span class="slabel" data-text-cvar="ui_bot0_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 0 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 0 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 0 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 0 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 0 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 0 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot1_name!=&amp;ui_bot1_mate=1"><span class="slabel" data-text-cvar="ui_bot1_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 1 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 1 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 1 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 1 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 1 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 1 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot2_name!=&amp;ui_bot2_mate=1"><span class="slabel" data-text-cvar="ui_bot2_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 2 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 2 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 2 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 2 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 2 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 2 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot3_name!=&amp;ui_bot3_mate=1"><span class="slabel" data-text-cvar="ui_bot3_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 3 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 3 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 3 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 3 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 3 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 3 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot4_name!=&amp;ui_bot4_mate=1"><span class="slabel" data-text-cvar="ui_bot4_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 4 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 4 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 4 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 4 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 4 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 4 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot5_name!=&amp;ui_bot5_mate=1"><span class="slabel" data-text-cvar="ui_bot5_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 5 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 5 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 5 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 5 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 5 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 5 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot6_name!=&amp;ui_bot6_mate=1"><span class="slabel" data-text-cvar="ui_bot6_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 6 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 6 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 6 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 6 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 6 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 6 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot7_name!=&amp;ui_bot7_mate=1"><span class="slabel" data-text-cvar="ui_bot7_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 7 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 7 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 7 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 7 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 7 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 7 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot8_name!=&amp;ui_bot8_mate=1"><span class="slabel" data-text-cvar="ui_bot8_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 8 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 8 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 8 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 8 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 8 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 8 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot9_name!=&amp;ui_bot9_mate=1"><span class="slabel" data-text-cvar="ui_bot9_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 9 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 9 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 9 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 9 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 9 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 9 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot10_name!=&amp;ui_bot10_mate=1"><span class="slabel" data-text-cvar="ui_bot10_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 10 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 10 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 10 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 10 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 10 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 10 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot11_name!=&amp;ui_bot11_mate=1"><span class="slabel" data-text-cvar="ui_bot11_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 11 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 11 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 11 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 11 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 11 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 11 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot12_name!=&amp;ui_bot12_mate=1"><span class="slabel" data-text-cvar="ui_bot12_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 12 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 12 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 12 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 12 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 12 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 12 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot13_name!=&amp;ui_bot13_mate=1"><span class="slabel" data-text-cvar="ui_bot13_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 13 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 13 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 13 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 13 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 13 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 13 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot14_name!=&amp;ui_bot14_mate=1"><span class="slabel" data-text-cvar="ui_bot14_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 14 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 14 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 14 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 14 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 14 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 14 5">[bt_report]</button></span></div>
			<div class="srow" data-when="ui_bot15_name!=&amp;ui_bot15_mate=1"><span class="slabel" data-text-cvar="ui_bot15_name"></span><span class="svalue"><button class="opt" onclick="ui_botOrder 15 0">[bt_follow]</button><button class="opt" data-when="ui_botCtf=0" onclick="ui_botOrder 15 1">[bt_roam]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 15 2">[bt_defend]</button><button class="opt" data-when="ui_botCtf=1" onclick="ui_botOrder 15 3">[bt_getflag]</button><button class="opt" onclick="ui_botOrder 15 4">[bt_camp]</button><button class="opt" onclick="ui_botOrder 15 5">[bt_report]</button></span></div>
		</div>
		<div class="sactions">
			<button onclick="rml_show ui/ingame.rml">[menu_back]</button>
		</div>
	</div>
</body>
</rml>
