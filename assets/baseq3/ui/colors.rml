	<div class="colorpreview">
		<button class="opt" data-class="on:ui_colorPreview=enemy" onclick="set ui_colorPreview enemy">[col_enemy]</button>
		<button class="opt" data-class="on:ui_colorPreview=team" onclick="set ui_colorPreview team">[col_team]</button>
	</div>
</body>
</rml>
