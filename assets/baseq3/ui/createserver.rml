<rml>
<head>
	<title>Create server</title>
	<link type="text/rcss" href="tremor.rcss"/>
</head>
<body data-escape="rml_show ui/main.rml">
	<div class="create">
		<h1><span data-when="ui_csPractice!=1">[cs_title]</span><span data-when="ui_csPractice=1">[pr_title]</span></h1>
		<div class="modes">
			<button class="opt mode" data-class="on:ui_csModeShown=duel" onclick="ui_csMode duel">[mode_duel]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=ffa" onclick="ui_csMode ffa">[mode_ffa]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=tdm" onclick="ui_csMode tdm">[mode_tdm]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=tdm2v2" onclick="ui_csMode tdm2v2">[mode_tdm2v2]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=ctf" onclick="ui_csMode ctf">[mode_ctf]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=ca" onclick="ui_csMode ca">[mode_ca]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=sacrifice" onclick="ui_csMode sacrifice">[mode_sacrifice]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=roundduel" onclick="ui_csMode roundduel">[mode_roundduel]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=instagib" onclick="ui_csMode instagib">[mode_instagib]</button>
			<button class="opt mode" data-class="on:ui_csModeShown=unholytrinity" onclick="ui_csMode unholytrinity">[mode_unholytrinity]</button>
			<button class="opt mode" data-when="ui_csPractice=1" data-class="on:ui_csModeShown=movement" onclick="ui_csMode movement">[mode_movement]</button>
		</div>
		<div class="maplist">
			<div class="mrow" data-repeat="64" data-when="ui_csMap#!=" data-class="on:ui_csPicked=#" onclick="ui_csPick #"><span data-text-cvar="ui_csMap#"></span></div>
		</div>
		<div class="preview" data-when="ui_csShotSel!=">
			<img data-src-cvar="ui_csShotSel"/>
			<div class="pname" data-text-cvar="ui_csMapName"></div>
		</div>
		<div class="pager" data-when="ui_csPages>1">
			<button class="opt" onclick="ui_csPage -1">&lt;</button>
			<span data-text-cvar="ui_csPageText"></span>
			<button class="opt" onclick="ui_csPage 1">&gt;</button>
		</div>
	</div>
	<div class="csopts">
		<div class="row"><span class="label">[cs_map]</span><span class="value" data-text-cvar="ui_csMapName"></span></div>
		<div class="row" data-when="ui_csPractice=1"><span class="label">[pr_opponents]</span>
			<button class="opt" onclick="ui_prCount opp -1">-</button><span class="value" data-text-cvar="ui_prOpp"></span><button class="opt" onclick="ui_prCount opp 1">+</button></div>
		<div class="row" data-when="ui_csPractice=1&amp;ui_csTeams=1"><span class="label">[pr_teammates]</span>
			<button class="opt" onclick="ui_prCount mates -1">-</button><span class="value" data-text-cvar="ui_prMates"></span><button class="opt" onclick="ui_prCount mates 1">+</button></div>
		<div class="row" data-when="ui_csPractice=1"><span class="label">[pr_champ]</span>
			<button class="opt" onclick="ui_prChampStep -1">&lt;</button><span class="value" data-text-cvar="ui_prChampName"></span><button class="opt" onclick="ui_prChampStep 1">&gt;</button></div>
		<div class="row" data-when="ui_csPractice!=1"><span class="label">[cs_name]</span><input type="text" maxlength="31" size="20" data-value-cvar="sv_hostname" onchange="set sv_hostname {value}"/></div>
		<div class="row" data-when="ui_csPractice!=1"><span class="label">[cs_bots]</span>
			<button class="opt" onclick="ui_csBotsAdd -1">-</button><span class="value" data-text-cvar="ui_csBots"></span><button class="opt" onclick="ui_csBotsAdd 1">+</button></div>
		<div class="row"><span class="label">[cs_time]</span>
			<button class="opt" onclick="ui_csLimit time -5">-</button><span class="value" data-text-cvar="ui_csTimeText"></span><button class="opt" onclick="ui_csLimit time 5">+</button></div>
		<div class="row"><span class="label">[cs_frags]</span>
			<button class="opt" onclick="ui_csLimit frags -5">-</button><span class="value" data-text-cvar="ui_csFragsText"></span><button class="opt" onclick="ui_csLimit frags 5">+</button></div>
		<div class="row"><span class="label">[cs_skill]</span><button class="opt" data-class="on:ui_csSkill=1" onclick="set ui_csSkill 1">1</button><button class="opt" data-class="on:ui_csSkill=2" onclick="set ui_csSkill 2">2</button><button class="opt" data-class="on:ui_csSkill=3" onclick="set ui_csSkill 3">3</button><button class="opt" data-class="on:ui_csSkill=4" onclick="set ui_csSkill 4">4</button><button class="opt" data-class="on:ui_csSkill=5" onclick="set ui_csSkill 5">5</button></div>
		<div class="row" data-when="ui_csPractice!=1"><span class="label">[cs_server]</span>
			<button class="opt" data-class="on:ui_csDedicated=0" onclick="set ui_csDedicated 0">[cs_play]</button>
			<button class="opt" data-class="on:ui_csDedicated=1" onclick="set ui_csDedicated 1">[cs_lan]</button>
			<button class="opt" data-class="on:ui_csDedicated=2" onclick="set ui_csDedicated 2">[cs_internet]</button>
		</div>
		<div class="note" data-when="ui_csPractice!=1">[cs_note]</div>
		<div class="csactions">
			<button onclick="rml_show ui/main.rml">[menu_back]</button>
			<button class="go" onclick="ui_csNext">[cs_next]</button>
		</div>
	</div>
</body>
</rml>
