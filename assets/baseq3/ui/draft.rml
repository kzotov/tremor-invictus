<rml>
<head>
	<title>Draft</title>
	<link type="text/rcss" href="tremor.rcss"/>
</head>
<body>
	<div class="draft">
		<h1>[draft_title]</h1>
		<div class="sub">[draft_turn]</div>
		<div class="grid">
		<button onclick="pick ranger">[champ_ranger][$dr_t_ranger]</button>
		<button onclick="pick anarki">[champ_anarki][$dr_t_anarki]</button>
		<button onclick="pick athena">[champ_athena][$dr_t_athena]</button>
		<button onclick="pick nyx">[champ_nyx][$dr_t_nyx]</button>
		<button onclick="pick slash">[champ_slash][$dr_t_slash]</button>
		<button onclick="pick bj">[champ_bj][$dr_t_bj]</button>
		<button onclick="pick deathknight">[champ_deathknight][$dr_t_deathknight]</button>
		<button onclick="pick doomslayer">[champ_doomslayer][$dr_t_doomslayer]</button>
		<button onclick="pick eisen">[champ_eisen][$dr_t_eisen]</button>
		<button onclick="pick galena">[champ_galena][$dr_t_galena]</button>
		<button onclick="pick strogg">[champ_strogg][$dr_t_strogg]</button>
		<button onclick="pick visor">[champ_visor][$dr_t_visor]</button>
		<button onclick="pick clutch">[champ_clutch][$dr_t_clutch]</button>
		<button onclick="pick keel">[champ_keel][$dr_t_keel]</button>
		<button onclick="pick scalebearer">[champ_scalebearer][$dr_t_scalebearer]</button>
		<button onclick="pick sorlag">[champ_sorlag][$dr_t_sorlag]</button>
		<button onclick="pick wrack">[champ_wrack][$dr_t_wrack]</button>
		<button onclick="pick sarge">[champ_sarge][$dr_t_sarge]</button>
		<button onclick="pick klesk">[champ_klesk][$dr_t_klesk]</button>
		<button onclick="pick hunter">[champ_hunter][$dr_t_hunter]</button>
		<button onclick="pick xaero">[champ_xaero][$dr_t_xaero]</button>
		<button onclick="pick raine">[champ_raine][$dr_t_raine]</button>
		<button onclick="pick beastmaster">[champ_beastmaster][$dr_t_beastmaster]</button>
		<button onclick="pick unumrey">[champ_unumrey][$dr_t_unumrey]</button>
		</div>
	</div>
</body>
</rml>
