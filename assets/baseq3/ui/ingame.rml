<rml>
<head>
	<title>In-game menu</title>
	<link type="text/rcss" href="tremor.rcss"/>
</head>
<body data-escape="rml_hide; ui_close">
	<div class="panel">
		<div class="logo"/>
		<div class="menu">
			<button onclick="rml_hide; ui_close">[menu_resume]</button>
			<button data-when="g_gametype!=1" onclick="rml_hide; ui_champions">[menu_champion]</button>
			<button onclick="rml_hide; ui_colors">[menu_player_colors]</button>
			<button onclick="rml_hide; ui_settings">[menu_settings]</button>
			<button onclick="rml_hide; ui_team">[menu_join_team]</button>
			<button data-when="sv_running=1&amp;bot_enable=1" onclick="rml_hide; ui_addbots">[menu_add_bots]</button>
			<button data-when="sv_running=1&amp;bot_enable=1" onclick="rml_hide; ui_removebots">[menu_remove_bots]</button>
			<button data-when="sv_running=1&amp;bot_enable=1&amp;g_gametype>=3" onclick="rml_hide; ui_teamOrders">[menu_team_orders]</button>
			<div class="gap"/>
			<button onclick="rml_hide; disconnect">[menu_leave]</button>
			<button onclick="quit">[menu_quit]</button>
		</div>
	</div>
</body>
</rml>
