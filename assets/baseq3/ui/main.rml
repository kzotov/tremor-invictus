<rml>
<head>
	<title>Main menu</title>
	<link type="text/rcss" href="tremor.rcss"/>
</head>
<body>
	<div class="logo"/>
	<div class="menu">
		<button id="play" onclick="rml_toggle play_menu">[menu_play]</button>
		<div class="submenu" id="play_menu">
			<button class="small" onclick="mm_profile; rml_show ui/findmatch.rml">[menu_find_match]</button>
			<button class="small" onclick="rml_hide; ui_practice">[menu_practice]</button>
			<button class="small" onclick="rml_hide; ui_servers">[menu_find_servers]</button>
			<button class="small" onclick="rml_hide; ui_createServer">[menu_create_server]</button>
		</div>
		<button onclick="ui_champions">[menu_champions]</button>
		<button onclick="rml_hide; ui_colors">[menu_player_colors]</button>
		<button onclick="rml_hide; ui_settings">[menu_settings]</button>
		<button onclick="rml_hide; ui_demos">[menu_demos]</button>
		<button onclick="quit">[menu_quit]</button>
	</div>
	<div class="searchbar" data-when="mm_state=searching">
		[mm_searching] <span data-text-cvar="mm_elapsed">0:00</span>
		<button class="small" onclick="mm_cancel">[mm_cancel]</button>
	</div>
	<div class="stage mainstage" data-stage="champion"></div>
	<div class="maininfo">
		<div class="chname" data-text-cvar="ui_chCurrentName"></div>
		<div class="chclass" data-text-cvar="ui_chCurrentInfo"></div>
		<button class="small" onclick="ui_champions">[ch_change]</button>
	</div>
	<div class="who" data-text-cvar="ui_playerName"></div>
	<div class="footer">[menu_footer]</div>
</body>
</rml>
