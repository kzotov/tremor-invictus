/* The Tab scoreboard (scoreboard.md): one centred panel over the game,
   fixed columns per mode, a team stripe on each row's left edge */

body {
	font-family: "Roboto Condensed";
	font-weight: bold;
	color: #e8e4dc;
	width: 100%;
	height: 100%;
}

div { display: block; }

.board {
	display: block;
	width: 1400dp;
	max-width: 88%;
	margin: 120dp auto 0dp auto;
	padding: 20dp 24dp 16dp 24dp;
	background-color: rgba(10, 10, 14, 210);
}

/* the header */
.top {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	margin-bottom: 14dp;
}
.title { font-size: 18dp; color: #9a9aa0; }
.line { font-size: 30dp; }
.time { font-size: 22dp; text-align: right; }
.round { font-size: 18dp; color: #9a9aa0; text-align: right; }

/* rows */
.row {
	display: flex;
	align-items: center;
	height: 40dp;
	margin-bottom: 4dp;
	border-left: 6dp transparent;
	font-size: 22dp;
	white-space: nowrap;
}
.row:nth-child(even) { background-color: rgba(255, 255, 255, 10); }
.row.head {
	height: 24dp;
	font-size: 15dp;
	color: #9a9aa0;
	background-color: transparent;
}
.row.red { border-left-color: #fc203c; }
.row.blue { border-left-color: #00a7ff; }
.row.self {
	border: 2dp #e8edf3;
	border-left-width: 6dp;
	background-color: rgba(255, 255, 255, 26);
}
.row.self.red { border-left-color: #fc203c; }
.row.self.blue { border-left-color: #00a7ff; }
.row.connecting { color: #8a8a90; }

.row span { display: block; overflow: hidden; }
.c-rank { width: 48dp; text-align: right; padding-right: 8dp; }
.c-por { width: 40dp; height: 32dp; }
.c-por img { width: 32dp; height: 32dp; margin-left: 4dp; }
.c-name { width: 360dp; padding-left: 8dp; text-overflow: ellipsis; }
.v { width: 90dp; text-align: right; }
.v.wide { width: 110dp; }
.c-ping { width: 80dp; text-align: right; padding-right: 10dp; }
.good { color: #5bd75b; }
.mid { color: #e8d04a; }
.bad { color: #ff5050; }
.bot { color: #9a9aa0; }

.cols3 .v4th, .cols3 .v5th { display: none; }
.cols4 .v5th { display: none; }

/* team modes: two columns */
.teams { display: flex; justify-content: space-between; }
.team { width: 49%; }
.team .c-rank { display: none; }
.team .c-name { width: 220dp; flex: 1; }
.team .v { width: 70dp; }
.team .v.wide { width: 90dp; }
.team .c-ping { width: 60dp; }
.teamhead {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	height: 60dp;
	margin-bottom: 6dp;
	border-bottom: 3dp transparent;
}
.teamhead.red { border-bottom-color: #fc203c; color: #ff8090; }
.teamhead.blue { border-bottom-color: #00a7ff; color: #80d3ff; }
.teamname { font-size: 26dp; color: #e8edf3; }
.teamscore { font-size: 48dp; }
.teamtotal { font-size: 15dp; color: #9a9aa0; }

/* duel (scoreboard.md 3.1): blue against red, mirrored */
.dtop { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14dp; }
.dtitle { font-size: 26dp; }
.dmap { font-size: 18dp; color: #9a9aa0; }
.dclock { font-size: 26dp; text-align: right; }
.dlimits { font-size: 15dp; color: #9a9aa0; text-align: right; }
.dbands { display: flex; justify-content: space-between; margin-bottom: 12dp; }
.dband { display: flex; align-items: center; width: 49.5%; height: 72dp; }
.dband.blue { background-color: rgba(0, 167, 255, 140); }
.dband.red { background-color: rgba(252, 32, 60, 140); }
.dband.right { justify-content: flex-end; }
.dpor { width: 56dp; height: 56dp; margin: 0dp 10dp; }
.dwho { flex: 1; }
.dband.right .dwho { text-align: right; }
.dname { font-size: 24dp; }
.dping { font-size: 15dp; color: #e8e4dc; }
.dping.good { color: #5bd75b; }
.dping.mid { color: #e8d04a; }
.dping.bad { color: #ff5050; }
.dping.bot { color: #c8c8cc; }
.dscore { font-size: 64dp; width: 110dp; text-align: center; }
.dbody { display: flex; }
.dpickups { width: 110dp; padding-top: 34dp; }
.dpk { display: flex; align-items: center; height: 36dp; font-size: 22dp; }
.dpk img { width: 28dp; height: 28dp; margin-right: 8dp; }
.dtable { flex: 1; }
.drow { display: flex; justify-content: center; align-items: center; height: 30dp; font-size: 20dp; }
.drow:nth-child(even) { background-color: rgba(255, 255, 255, 10); }
.drow span { display: block; width: 90dp; text-align: center; font-family: "Roboto Condensed"; }
.drow .dicon { width: 64dp; }
.drow img { width: 48dp; height: 24dp; }
.dhead { font-size: 15dp; color: #9a9aa0; height: 24dp; }
.dtotal { border-top: 1dp #5a5a60; font-size: 22dp; }

.specs { margin-top: 12dp; font-size: 15dp; color: #9a9aa0; }

/* A restrained horizontal fade; palette indices match CG_TeamPalette. */
.board.palette0 .row.red, .board.palette0 .row.self.red { border-left-color: #fc203c; }
.board.palette0 .teamhead.red { border-bottom-color: #fc203c; color: #fc203c; decorator: horizontal-gradient(rgba(252, 32, 60, 28) rgba(252, 32, 60, 0)); }
.board.palette0 .dband.red { background-color: transparent; decorator: horizontal-gradient(rgba(252, 32, 60, 150) rgba(252, 32, 60, 35)); }
.board.palette0 .row.blue, .board.palette0 .row.self.blue { border-left-color: #00a7ff; }
.board.palette0 .teamhead.blue { border-bottom-color: #00a7ff; color: #00a7ff; decorator: horizontal-gradient(rgba(0, 167, 255, 28) rgba(0, 167, 255, 0)); }
.board.palette0 .dband.blue { background-color: transparent; decorator: horizontal-gradient(rgba(0, 167, 255, 150) rgba(0, 167, 255, 35)); }
.board.palette1 .row.red, .board.palette1 .row.self.red { border-left-color: #ff8c00; }
.board.palette1 .teamhead.red { border-bottom-color: #ff8c00; color: #ff8c00; decorator: horizontal-gradient(rgba(255, 140, 0, 28) rgba(255, 140, 0, 0)); }
.board.palette1 .dband.red { background-color: transparent; decorator: horizontal-gradient(rgba(255, 140, 0, 150) rgba(255, 140, 0, 35)); }
.board.palette1 .row.blue, .board.palette1 .row.self.blue { border-left-color: #1a73ff; }
.board.palette1 .teamhead.blue { border-bottom-color: #1a73ff; color: #1a73ff; decorator: horizontal-gradient(rgba(26, 115, 255, 28) rgba(26, 115, 255, 0)); }
.board.palette1 .dband.blue { background-color: transparent; decorator: horizontal-gradient(rgba(26, 115, 255, 150) rgba(26, 115, 255, 35)); }
.board.palette2 .row.red, .board.palette2 .row.self.red { border-left-color: #ffd91a; }
.board.palette2 .teamhead.red { border-bottom-color: #ffd91a; color: #ffd91a; decorator: horizontal-gradient(rgba(255, 217, 26, 28) rgba(255, 217, 26, 0)); }
.board.palette2 .dband.red { background-color: transparent; decorator: horizontal-gradient(rgba(255, 217, 26, 150) rgba(255, 217, 26, 35)); }
.board.palette2 .row.blue, .board.palette2 .row.self.blue { border-left-color: #1a73ff; }
.board.palette2 .teamhead.blue { border-bottom-color: #1a73ff; color: #1a73ff; decorator: horizontal-gradient(rgba(26, 115, 255, 28) rgba(26, 115, 255, 0)); }
.board.palette2 .dband.blue { background-color: transparent; decorator: horizontal-gradient(rgba(26, 115, 255, 150) rgba(26, 115, 255, 35)); }
.board.palette3 .row.red, .board.palette3 .row.self.red { border-left-color: #ff2633; }
.board.palette3 .teamhead.red { border-bottom-color: #ff2633; color: #ff2633; decorator: horizontal-gradient(rgba(255, 38, 51, 28) rgba(255, 38, 51, 0)); }
.board.palette3 .dband.red { background-color: transparent; decorator: horizontal-gradient(rgba(255, 38, 51, 150) rgba(255, 38, 51, 35)); }
.board.palette3 .row.blue, .board.palette3 .row.self.blue { border-left-color: #00bfbf; }
.board.palette3 .teamhead.blue { border-bottom-color: #00bfbf; color: #00bfbf; decorator: horizontal-gradient(rgba(0, 191, 191, 28) rgba(0, 191, 191, 0)); }
.board.palette3 .dband.blue { background-color: transparent; decorator: horizontal-gradient(rgba(0, 191, 191, 150) rgba(0, 191, 191, 35)); }
