<rml>
<head>
	<title>Scoreboard</title>
	<link type="text/rcss" href="scoreboard.rcss"/>
</head>
<!-- The Tab board (scoreboard.md), drawn over the game while the game
     sets rml_overlay. Rows come from sb_* cvars, fields split by '|':
     list rows   classes|portrait|rank|name|v|v|v|v|v|v|ping|ping class
     team header classes|name|score|totals
     duel bands  side class|portrait|name|ping|ping class|score
     pickups     icon|count
     weapons     icon|hits|acc|dmg|score (blue)|score|dmg|acc|hits (red), sb_wt the total -->
<body>
	<div class="board" data-row="sb_palette" data-cell-class="0">
		<div class="top" data-when="sb_mode!=duel">
			<div>
				<div class="title" data-text-cvar="sb_title"></div>
				<div class="line" data-text-cvar="sb_line"></div>
			</div>
			<div>
				<div class="time" data-text-cvar="sb_time"></div>
				<div class="round" data-when="sb_round!=" data-text-cvar="sb_round"></div>
			</div>
		</div>

		<!-- free-for-all -->
		<div class="ffa" data-when="sb_mode=ffa">
			<div class="row head" data-row="sb_head" data-cell-class="0">
				<span class="c-rank" data-cell="2"></span><span class="c-por"></span><span class="c-name" data-cell="3"></span>
				<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
				<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10"></span>
			</div>
			<div class="row" data-row="sb_f#" data-repeat="24" data-cell-class="0">
				<span class="c-rank" data-cell="2"></span><span class="c-por"><img data-cell-src="1"/></span><span class="c-name" data-cell="3"></span>
				<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
				<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10" data-cell-class="11"></span>
			</div>
		</div>

		<!-- team modes: blue team on the left -->
		<div class="teams" data-when="sb_mode=team">
			<div class="team">
				<div class="teamhead" data-row="sb_lt" data-cell-class="0">
					<div><div class="teamname" data-cell="1"></div><div class="teamtotal" data-cell="3"></div></div>
					<div class="teamscore" data-cell="2"></div>
				</div>
				<div class="row head" data-row="sb_head" data-cell-class="0">
					<span class="c-por"></span><span class="c-name" data-cell="3"></span>
					<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
					<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10"></span>
				</div>
				<div class="row" data-row="sb_l#" data-repeat="12" data-cell-class="0">
					<span class="c-por"><img data-cell-src="1"/></span><span class="c-name" data-cell="3"></span>
					<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
					<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10" data-cell-class="11"></span>
				</div>
			</div>
			<div class="team">
				<div class="teamhead" data-row="sb_rt" data-cell-class="0">
					<div><div class="teamname" data-cell="1"></div><div class="teamtotal" data-cell="3"></div></div>
					<div class="teamscore" data-cell="2"></div>
				</div>
				<div class="row head" data-row="sb_head" data-cell-class="0">
					<span class="c-por"></span><span class="c-name" data-cell="3"></span>
					<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
					<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10"></span>
				</div>
				<div class="row" data-row="sb_r#" data-repeat="12" data-cell-class="0">
					<span class="c-por"><img data-cell-src="1"/></span><span class="c-name" data-cell="3"></span>
					<span class="v" data-cell="4"></span><span class="v" data-cell="5"></span><span class="v" data-cell="6"></span>
					<span class="v v4th" data-cell="7"></span><span class="v v5th" data-cell="8"></span><span class="c-ping" data-cell="10" data-cell-class="11"></span>
				</div>
			</div>
		</div>

		<!-- duel (scoreboard.md 3.1): blue against red, mirrored -->
		<div data-when="sb_mode=duel">
			<div class="dtop">
				<div>
					<div class="dtitle" data-text-cvar="sb_dtitle"></div>
					<div class="dmap" data-text-cvar="sb_dmap"></div>
				</div>
				<div>
					<div class="dclock" data-text-cvar="sb_dclock"></div>
					<div class="dlimits" data-text-cvar="sb_dlimits"></div>
				</div>
			</div>
			<div class="dbands">
				<div class="dband" data-row="sb_d0" data-cell-class="0">
					<img class="dpor" data-cell-src="1"/>
					<div class="dwho"><div class="dname" data-cell="2"></div><div class="dping" data-cell="3" data-cell-class="4"></div></div>
					<div class="dscore" data-cell="5"></div>
				</div>
				<div class="dband right" data-row="sb_d1" data-cell-class="0">
					<div class="dscore" data-cell="5"></div>
					<div class="dwho"><div class="dname" data-cell="2"></div><div class="dping" data-cell="3" data-cell-class="4"></div></div>
					<img class="dpor" data-cell-src="1"/>
				</div>
			</div>
			<div class="dbody">
				<div class="dpickups">
					<div class="dpk" data-row="sb_pk#" data-repeat="6"><img data-cell-src="0" data-cell-anchor="2"/><span data-cell="1"></span></div>
				</div>
				<div class="dtable">
					<div class="drow dhead" data-row="sb_dh">
						<span data-cell="0"></span><span data-cell="1"></span><span data-cell="2"></span><span data-cell="3"></span>
						<span class="dicon"></span>
						<span data-cell="3"></span><span data-cell="2"></span><span data-cell="1"></span><span data-cell="0"></span>
					</div>
					<div class="drow" data-row="sb_w#" data-repeat="16">
						<span data-cell="1"></span><span data-cell="2"></span><span data-cell="3"></span><span data-cell="4"></span>
						<span class="dicon"><img data-cell-src="0" data-cell-anchor="9"/></span>
						<span data-cell="5"></span><span data-cell="6"></span><span data-cell="7"></span><span data-cell="8"></span>
					</div>
					<div class="drow dtotal" data-row="sb_wt">
						<span data-cell="1"></span><span data-cell="2"></span><span data-cell="3"></span><span data-cell="4"></span>
						<span class="dicon" data-cell="0"></span>
						<span data-cell="5"></span><span data-cell="6"></span><span data-cell="7"></span><span data-cell="8"></span>
					</div>
				</div>
			</div>
		</div>

		<div class="specs" data-when="sb_specs!=" data-text-cvar="sb_specs"></div>
	</div>
</body>
</rml>
