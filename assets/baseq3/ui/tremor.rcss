/* tremor-invictus interface: the logo palette (dark slate, logo red, bone
   white), flat panels, text buttons with a red bar on hover */

body {
	font-family: "Arial Narrow";
	font-weight: bold;
	color: #e8e4dc;
	width: 100%;
	height: 100%;
}

.logo {
	position: absolute;
	left: 80dp;
	top: 70dp;
	width: 512dp;
	height: 135dp;
	decorator: image( /gfx/tremor/logo.png );
}

.menu {
	position: absolute;
	left: 80dp;
	top: 300dp;
	width: 640dp;
}

button {
	display: block;
	font-family: "Arial Black";
	font-size: 46dp;
	color: #d3191f;
	padding: 6dp 0dp 6dp 22dp;
	margin-bottom: 8dp;
	border-left: 6dp transparent;
	transition: padding-left color border-left-color 0.15s cubic-out;
	cursor: pointer;
}

button:hover, button:focus-visible {
	color: #f2efe9;
	border-left-color: #d3191f;
	padding-left: 34dp;
	background-color: #d3191f22;
}

button.small {
	font-size: 34dp;
}

.submenu {
	display: none;
	margin: 0dp 0dp 18dp 40dp;
}

.submenu.open {
	display: block;
}

.footer {
	position: absolute;
	bottom: 30dp;
	width: 100%;
	text-align: center;
	font-family: "Arial Narrow";
	font-weight: normal;
	font-size: 24dp;
	color: #8a8780;
}

/* the in-game menu: a panel down the left over the dimmed game */
.panel {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 460dp;
	height: 100%;
	background-color: #16171be8;
	border-right: 2dp #2a2b30;
}

.panel .logo {
	left: 40dp;
	top: 36dp;
	width: 380dp;
	height: 100dp;
}

.panel .menu {
	left: 40dp;
	top: 200dp;
	width: 400dp;
}

.panel button {
	font-size: 34dp;
	margin-bottom: 4dp;
}

.panel .gap {
	display: block;
	height: 30dp;
	margin-bottom: 0dp;
}

/* the join screen: a centred card over the game */
.card {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 720dp;
	margin-left: -360dp;
	margin-top: -300dp;
	padding: 40dp 50dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
}

.card h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 44dp;
	color: #f2efe9;
	margin-bottom: 10dp;
}

.card .sub {
	display: block;
	font-size: 30dp;
	color: #8a8780;
	margin-bottom: 30dp;
}

.card button {
	font-size: 38dp;
	margin-bottom: 6dp;
}

.panel .where {
	position: absolute;
	left: 40dp;
	top: 140dp;
	font-size: 26dp;
	color: #8a8780;
}

/* round duel draft: the champions to pick, along the top over the pedestals */
.draft {
	position: absolute;
	left: 5%;
	top: 30dp;
	width: 90%;
}

.draft h1 {
	display: block;
	text-align: center;
	font-family: "Arial Black";
	font-size: 40dp;
	color: #f2efe9;
}

.draft .sub {
	display: block;
	text-align: center;
	font-size: 24dp;
	color: #8a8780;
	margin-bottom: 14dp;
}

.draft .grid button {
	display: inline-block;
	width: 15%;
	font-size: 24dp;
	padding: 6dp 10dp;
	margin: 2dp;
	border-left-width: 4dp;
}

/* the end-of-match map vote along the bottom of the end board */
.vote {
	position: absolute;
	left: 0dp;
	bottom: 0dp;
	width: 100%;
	height: 33%;
	background-color: #101114e6;
	text-align: center;
}

.vote h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 34dp;
	color: #f2efe9;
	margin-top: 16dp;
}

.vote .maps {
	display: block;
	margin-top: 10dp;
}

.vote .map {
	display: inline-block;
	width: 300dp;
	margin: 0dp 16dp;
	padding: 6dp;
	border: 3dp transparent;
	cursor: pointer;
	font-size: 26dp;
	color: #e8e4dc;
}

.vote .map:hover {
	border-color: #e8e4dc;
}

.vote .map.mine {
	border-color: #d3191f;
	background-color: #d3191f33;
}

.vote .map img {
	display: block;
	width: 288dp;
	height: 162dp;
}

.vote .help {
	display: block;
	font-size: 22dp;
	color: #8a8780;
	margin-top: 8dp;
}

/* find match: a row per mode with your rating, ticked rows queue */
.findmatch {
	position: absolute;
	left: 50%;
	top: 120dp;
	width: 900dp;
	margin-left: -450dp;
	padding: 40dp 50dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
}

.findmatch h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 44dp;
	color: #f2efe9;
}

.findmatch .sub, .findmatch .id {
	display: block;
	font-size: 24dp;
	color: #8a8780;
	margin-bottom: 20dp;
}

.findmatch .id {
	margin-top: 20dp;
	margin-bottom: 0dp;
	font-size: 18dp;
}

.findmatch .mode {
	display: block;
	font-size: 30dp;
	color: #8a8780;
	padding: 8dp 16dp;
	margin-bottom: 4dp;
	background-color: #0e0f12c0;
	border-left: 4dp #3a3b40;
}

.findmatch .mode:hover {
	color: #f2efe9;
}

.findmatch .mode.on {
	color: #f2efe9;
	border-left-color: #d3191f;
}

.findmatch .mode .rating {
	float: right;
}

.findmatch .error {
	display: block;
	font-size: 24dp;
	color: #e0a030;
	margin-top: 10dp;
}

.findmatch .actions {
	display: block;
	margin-top: 20dp;
}

.findmatch .actions button {
	display: inline-block;
	font-size: 34dp;
	margin-right: 20dp;
}

.findmatch .searching {
	display: inline-block;
	font-size: 30dp;
	color: #f2efe9;
	margin-right: 20dp;
}

/* the bar over the main menu while searching */
.searchbar {
	position: absolute;
	left: 0dp;
	right: 0dp;
	top: 0dp;
	padding: 10dp 40dp;
	font-size: 28dp;
	color: #f2efe9;
	background-color: #d3191fd0;
}

.searchbar button {
	display: inline-block;
	margin-left: 30dp;
	color: #f2efe9;
	font-size: 28dp;
	padding: 0dp;
	border-left-width: 0dp;
}

/* the ready check: a big countdown */
.card.ready .countdown {
	display: block;
	font-family: "Arial Black";
	font-size: 90dp;
	color: #d3191f;
	text-align: center;
	margin-bottom: 20dp;
}

/* the party row under the modes */
.findmatch .party {
	display: block;
	margin-top: 24dp;
	font-size: 26dp;
	color: #8a8780;
}

.findmatch .party button {
	display: inline-block;
	font-size: 30dp;
	margin-right: 20dp;
	margin-left: 20dp;
}

.findmatch .party div.label {
	display: block;
	margin-top: 6dp;
}

.findmatch .party .code {
	margin: 0dp 10dp;
	font-family: "Arial Black";
	font-size: 34dp;
	color: #f2efe9;
}

.findmatch .party input {
	display: inline-block;
	width: 160dp;
	font-size: 30dp;
	color: #f2efe9;
	background-color: #0e0f12;
	border: 2dp #3a3b40;
	padding: 4dp 10dp;
	margin-left: 10dp;
}

/* the champion stage: an empty box the menu module draws the champion into */
.stage {
	position: absolute;
	cursor: move;
}

.mainstage {
	right: 6%;
	top: 12%;
	width: 34%;
	height: 62%;
}

.maininfo {
	position: absolute;
	right: 6%;
	top: 75%;
	width: 34%;
	text-align: center;
}

.chname {
	display: block;
	font-family: "Arial Black";
	font-size: 48dp;
	color: #f2efe9;
}

.chclass {
	display: block;
	font-size: 26dp;
	color: #8a8780;
	margin-bottom: 6dp;
}

.maininfo button {
	display: inline-block;
	font-size: 30dp;
	padding-left: 0dp;
}

.who {
	position: absolute;
	right: 40dp;
	top: 30dp;
	font-size: 30dp;
	color: #f2efe9;
}

/* the Champions screen: portraits left, the stage in the middle, details right */
.champs {
	position: absolute;
	left: 3%;
	top: 4%;
	width: 36%;
}

.champs h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 50dp;
	color: #f2efe9;
	margin-bottom: 14dp;
}

.champs .cell {
	display: inline-block;
	position: relative;
	width: 18%;
	margin: 0 1% 1% 0;
	background-color: #16171bf0;
	border: 3dp #26272c;
	cursor: pointer;
}

.champs .cell:hover {
	border-color: #8a8780;
}

.champs .cell.shown {
	border-color: #d3191f;
}

.champs .cell img {
	display: block;
	width: 100%;
	height: 110dp;
}

.champs .cname {
	display: block;
	font-size: 18dp;
	color: #c8c4bc;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

.champs .mark {
	position: absolute;
	right: 4dp;
	top: 4dp;
	width: 16dp;
	height: 16dp;
	background-color: #d3191f;
}

.champs .bio {
	display: block;
	margin-top: 14dp;
	font-size: 22dp;
	color: #8a8780;
}

.champstage {
	left: 40%;
	top: 8%;
	width: 28%;
	height: 72%;
}

.chinfo {
	position: absolute;
	left: 69%;
	top: 8%;
	width: 28%;
	font-size: 24dp;
	color: #e8e4dc;
}

.chinfo .chname {
	font-size: 56dp;
}

.chinfo .stat {
	display: block;
	margin-top: 6dp;
}

.chinfo .label, .chinfo .aname {
	color: #8a8780;
	margin-right: 10dp;
}

.chinfo .aname {
	font-family: "Arial Black";
	color: #d3191f;
}

.chinfo .ability {
	display: block;
	margin-top: 16dp;
}

.chinfo .weapon {
	display: block;
	margin-top: 20dp;
}

.chinfo .weapon button {
	display: inline-block;
	font-size: 24dp;
	color: #8a8780;
	padding: 4dp 10dp;
	margin-right: 6dp;
	border-left-width: 0dp;
	background-color: #16171bf0;
}

.chinfo .weapon button.on {
	color: #f2efe9;
	background-color: #d3191f;
}

.chactions {
	position: absolute;
	left: 40%;
	bottom: 6%;
	width: 57%;
}

.chactions button {
	display: inline-block;
	margin-right: 60dp;
}

.chactions .select {
	font-size: 60dp;
	color: #f2efe9;
}

.chactions .selected, .chactions .locked {
	display: inline-block;
	font-family: "Arial Black";
	font-size: 50dp;
	color: #d3191f;
}

.chactions .locked {
	font-size: 30dp;
	color: #8a8780;
}

.chactions .tick {
	display: inline-block;
	width: 30dp;
	height: 30dp;
	margin-right: 14dp;
	background-color: #d3191f;
}

/* player colours: two columns of settings, the tinted champion beside them */
.colors {
	position: absolute;
	left: 4%;
	top: 6%;
	width: 58%;
}

.colors h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 50dp;
	color: #f2efe9;
}

.colors .sub {
	display: block;
	font-size: 24dp;
	color: #8a8780;
	margin-bottom: 20dp;
}

.colors .side {
	display: block;
	padding: 16dp 24dp;
	margin-bottom: 16dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
}

.colors h2 {
	display: block;
	font-family: "Arial Black";
	font-size: 32dp;
	color: #f2efe9;
	margin-bottom: 8dp;
}

.colors .row {
	display: block;
	margin-bottom: 8dp;
}

.colors .label {
	display: inline-block;
	width: 110dp;
	font-size: 24dp;
	color: #8a8780;
}

.opt {
	display: inline-block;
	font-size: 24dp;
	color: #8a8780;
	padding: 4dp 12dp;
	margin-right: 6dp;
	border-left-width: 0dp;
	background-color: #0e0f12;
}

.opt.on {
	color: #f2efe9;
	background-color: #d3191f;
}

.swatch {
	display: inline-block;
	width: 34dp;
	height: 30dp;
	margin-right: 6dp;
	border: 3dp #0e0f12;
	cursor: pointer;
}

.swatch:hover {
	border-color: #8a8780;
}

.swatch.on {
	border-color: #f2efe9;
}

.colors .actions button {
	display: inline-block;
}

.colorstage {
	left: 66%;
	top: 10%;
	width: 30%;
	height: 70%;
}

.colorpreview {
	position: absolute;
	left: 66%;
	top: 82%;
	width: 30%;
	text-align: center;
}

/* create server: modes along the top, a page of maps, options on the right */
.create {
	position: absolute;
	left: 3%;
	top: 4%;
	width: 62%;
}

.create h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 50dp;
	color: #f2efe9;
	margin-bottom: 12dp;
}

.create .modes {
	display: block;
	margin-bottom: 14dp;
}

.create .modes .opt {
	margin-bottom: 6dp;
}

.create .map {
	display: inline-block;
	width: 23%;
	margin: 0 1.5% 1.5% 0;
	background-color: #16171bf0;
	border: 3dp #26272c;
	cursor: pointer;
	font-size: 20dp;
	color: #c8c4bc;
	text-align: center;
}

.create .map:hover {
	border-color: #8a8780;
}

.create .map.on {
	border-color: #d3191f;
	color: #f2efe9;
}

.create .map img {
	display: block;
	width: 100%;
	height: 150dp;
}

.create .pager {
	display: block;
	font-size: 24dp;
	color: #8a8780;
}

.csopts {
	position: absolute;
	left: 68%;
	top: 14%;
	width: 29%;
	padding: 24dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
	font-size: 24dp;
}

.csopts .row {
	display: block;
	margin-bottom: 14dp;
}

.csopts .label {
	display: block;
	color: #8a8780;
	margin-bottom: 4dp;
}

.csopts .value {
	color: #f2efe9;
	margin: 0 12dp;
}

.csopts input {
	width: 90%;
	font-size: 26dp;
	color: #f2efe9;
	background-color: #0e0f12;
	border: 2dp #3a3b40;
	padding: 4dp 10dp;
}

.csopts .note {
	display: block;
	font-size: 18dp;
	color: #6a6760;
	margin: 10dp 0;
}

.csopts .csactions button {
	display: inline-block;
	margin-right: 40dp;
}

.csopts .go {
	color: #f2efe9;
	font-size: 54dp;
}

/* match found: every player's champion on a pillar, reds left, blues right */
.found {
	position: absolute;
	left: 3%;
	top: 4%;
	width: 94%;
	height: 92%;
	text-align: center;
}

.found h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 60dp;
	color: #f2efe9;
}

.found .sub {
	display: block;
	font-size: 30dp;
	color: #8a8780;
	margin-bottom: 20dp;
}

.found .lineup {
	display: block;
	height: 70%;
}

.found .slot {
	display: inline-block;
	position: relative;
	width: 11.5%;
	height: 100%;
	margin: 0 0.4%;
	border-top: 6dp #d3191f;
}

.found .slot.blue {
	border-top-color: #2850dc;
}

.found .slotstage {
	left: 0;
	top: 0;
	width: 100%;
	height: 78%;
}

.found .pname {
	position: absolute;
	left: 0;
	right: 0;
	top: 80%;
	font-size: 24dp;
	color: #f2efe9;
	white-space: nowrap;
	overflow: hidden;
}

.found .pchamp, .found .prating {
	position: absolute;
	left: 0;
	right: 0;
	top: 87%;
	font-size: 20dp;
	color: #8a8780;
}

.found .prating {
	top: 93%;
}

.found .foot {
	display: block;
	margin-top: 20dp;
	font-size: 28dp;
	color: #f2efe9;
}

.found .foot button {
	display: inline-block;
	margin-left: 40dp;
}

/* settings: tabs, then a row per setting with its help under the cursor */
.settings {
	position: absolute;
	left: 4%;
	top: 4%;
	width: 92%;
	height: 92%;
}

.settings h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 50dp;
	color: #f2efe9;
}

.settings .tabs {
	display: block;
	margin-bottom: 16dp;
}

.settings .tab {
	display: inline-block;
	font-size: 32dp;
	color: #8a8780;
	margin-right: 30dp;
	padding-left: 0dp;
	border-left-width: 0dp;
	border-bottom: 4dp transparent;
}

.settings .tab.on {
	color: #f2efe9;
	border-bottom-color: #d3191f;
}

.settings .spage {
	display: block;
	height: 72%;
	overflow-y: auto;
	padding: 10dp 20dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
}

.srow {
	display: block;
	position: relative;
	padding: 5dp 0;
	font-size: 22dp;
}

.srow:hover {
	background-color: #1f2026;
}

.slabel {
	display: inline-block;
	width: 32%;
	color: #8a8780;
	text-align: right;
	padding-right: 20dp;
}

.svalue {
	display: inline-block;
	width: 64%;
}

.svalue .opt {
	font-size: 20dp;
	padding: 2dp 8dp;
	margin: 0 4dp 4dp 0;
}

.svalue input {
	font-size: 22dp;
	color: #f2efe9;
	background-color: #0e0f12;
	border: 2dp #3a3b40;
	padding: 2dp 8dp;
}

.svalue input.range {
	width: 300dp;
	height: 20dp;
}

.sread {
	margin-left: 12dp;
	color: #f2efe9;
}

.sread.wait {
	color: #e0a030;
}

.shelp {
	display: none;
}

.srow:hover .shelp {
	display: block;
	padding-left: 34%;
	font-size: 18dp;
	color: #c8c4bc;
}

.settings .sactions {
	display: block;
	margin-top: 14dp;
}

.settings .sactions button {
	display: inline-block;
	font-size: 36dp;
	margin-right: 50dp;
}

.settings .sactions .apply {
	color: #f2efe9;
}

input.range slidertrack {
	height: 6dp;
	margin-top: 7dp;
	background-color: #3a3b40;
}

input.range sliderbar {
	width: 14dp;
	height: 20dp;
	background-color: #d3191f;
}

input.range sliderarrowdec, input.range sliderarrowinc {
	width: 0dp;
	height: 0dp;
}

scrollbarvertical {
	width: 12dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #0e0f12;
}

scrollbarvertical sliderbar {
	width: 12dp;
	min-height: 30dp;
	background-color: #3a3b40;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
	width: 0dp;
	height: 0dp;
}
