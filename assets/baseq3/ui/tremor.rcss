/* tremor-invictus interface: the logo palette (dark slate, logo red, bone
   white), flat panels, text buttons with a red bar on hover */

body {
	font-family: "Arial Narrow";
	font-weight: bold;
	color: #e8e4dc;
	width: 100%;
	height: 100%;
}

.logo {
	position: absolute;
	left: 80dp;
	top: 70dp;
	width: 512dp;
	height: 135dp;
	decorator: image( /gfx/tremor/logo.png );
}

.menu {
	position: absolute;
	left: 80dp;
	top: 300dp;
	width: 640dp;
}

button {
	display: block;
	font-family: "Arial Black";
	font-size: 46dp;
	color: #d3191f;
	padding: 6dp 0dp 6dp 22dp;
	margin-bottom: 8dp;
	border-left: 6dp transparent;
	transition: padding-left color border-left-color 0.15s cubic-out;
	cursor: pointer;
}

button:hover, button:focus-visible {
	color: #f2efe9;
	border-left-color: #d3191f;
	padding-left: 34dp;
	background-color: #d3191f22;
}

button.small {
	font-size: 34dp;
}

.submenu {
	display: none;
	margin: 0dp 0dp 18dp 40dp;
}

.submenu.open {
	display: block;
}

.footer {
	position: absolute;
	bottom: 30dp;
	width: 100%;
	text-align: center;
	font-family: "Arial Narrow";
	font-weight: normal;
	font-size: 24dp;
	color: #8a8780;
}

/* the in-game menu: a panel down the left over the dimmed game */
.panel {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 460dp;
	height: 100%;
	background-color: #16171be8;
	border-right: 2dp #2a2b30;
}

.panel .logo {
	left: 40dp;
	top: 36dp;
	width: 380dp;
	height: 100dp;
}

.panel .menu {
	left: 40dp;
	top: 200dp;
	width: 400dp;
}

.panel button {
	font-size: 34dp;
	margin-bottom: 4dp;
}

.panel .gap {
	display: block;
	height: 30dp;
	margin-bottom: 0dp;
}

/* the join screen: a centred card over the game */
.card {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 720dp;
	margin-left: -360dp;
	margin-top: -300dp;
	padding: 40dp 50dp;
	background-color: #16171bf0;
	border-left: 6dp #d3191f;
}

.card h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 44dp;
	color: #f2efe9;
	margin-bottom: 10dp;
}

.card .sub {
	display: block;
	font-size: 30dp;
	color: #8a8780;
	margin-bottom: 30dp;
}

.card button {
	font-size: 38dp;
	margin-bottom: 6dp;
}

.panel .where {
	position: absolute;
	left: 40dp;
	top: 140dp;
	font-size: 26dp;
	color: #8a8780;
}

/* round duel draft: the champions to pick, along the top over the pedestals */
.draft {
	position: absolute;
	left: 5%;
	top: 30dp;
	width: 90%;
}

.draft h1 {
	display: block;
	text-align: center;
	font-family: "Arial Black";
	font-size: 40dp;
	color: #f2efe9;
}

.draft .sub {
	display: block;
	text-align: center;
	font-size: 24dp;
	color: #8a8780;
	margin-bottom: 14dp;
}

.draft .grid button {
	display: inline-block;
	width: 15%;
	font-size: 24dp;
	padding: 6dp 10dp;
	margin: 2dp;
	border-left-width: 4dp;
}

/* the end-of-match map vote along the bottom of the end board */
.vote {
	position: absolute;
	left: 0dp;
	bottom: 0dp;
	width: 100%;
	height: 33%;
	background-color: #101114e6;
	text-align: center;
}

.vote h1 {
	display: block;
	font-family: "Arial Black";
	font-size: 34dp;
	color: #f2efe9;
	margin-top: 16dp;
}

.vote .maps {
	display: block;
	margin-top: 10dp;
}

.vote .map {
	display: inline-block;
	width: 300dp;
	margin: 0dp 16dp;
	padding: 6dp;
	border: 3dp transparent;
	cursor: pointer;
	font-size: 26dp;
	color: #e8e4dc;
}

.vote .map:hover {
	border-color: #e8e4dc;
}

.vote .map.mine {
	border-color: #d3191f;
	background-color: #d3191f33;
}

.vote .map img {
	display: block;
	width: 288dp;
	height: 162dp;
}

.vote .help {
	display: block;
	font-size: 22dp;
	color: #8a8780;
	margin-top: 8dp;
}
